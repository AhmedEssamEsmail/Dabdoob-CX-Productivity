[data-app=\"quality\"] .qa-card--strip .qa-acts { display:flex;gap:var(--cx-space-2);flex:none;margin-inline-start:auto }
[data-app=\"quality\"] .qa-card--strip .qa-detail { display:grid;gap:var(--cx-space-2);border-top:1px solid var(--cx-line);padding:var(--cx-space-2) var(--cx-space-3) var(--cx-space-3) }
[data-app=\"quality\"] .qa-card--strip .qa-detail .qa-reason { margin:0 }
[data-app=\"quality\"] .qa-card--strip .qa-detail .qa-ctlform { gap:var(--cx-space-2) }
[data-app=\"quality\"] .qa-cap { font-size:var(--cx-text-xs);font-weight:var(--cx-weight-strong);letter-spacing:.05em;text-transform:uppercase;color:var(--cx-ink-3) }
@media(max-width:64rem) {
  [data-app=\"quality\"] .qa-card--strip, [data-app=\"quality\"] .qa-card--strip>summary { flex-wrap:wrap }
