/* ============================ compact strip cards (Option A) ============================
   .qa-card--strip = single-line strip rows; <details> variant collapses to a
   summary row plus a .qa-detail expansion. Colors/spacing are --cx-* tokens only. */
[data-app=\"quality\"] .qa-list { display:grid;grid-template-columns:minmax(0,1fr);gap:var(--cx-space-2) }
[data-app=\"quality\"] .qa-card--strip, [data-app=\"quality\"] .qa-card--strip>summary { display:flex;align-items:center;gap:var(--cx-space-2);padding:var(--cx-space-1) var(--cx-space-3) }
