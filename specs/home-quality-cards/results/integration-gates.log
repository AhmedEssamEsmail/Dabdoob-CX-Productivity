[data-app=\"quality\"] .qs-tag { display:inline-block;font-size:var(--cx-text-xs);line-height:1.4;padding:0 var(--cx-space-2);border:1px solid var(--cx-line);border-radius:999px/* px-exact: tag pill */;color:var(--cx-ink-2);background:var(--cx-surface-2, transparent) }
