[data-app=\"quality\"] .qa-chev { inline-size:.9rem;block-size:.9rem;flex:none;color:var(--cx-ink-3);transition:transform .15s }
[data-app=\"quality\"] details.qa-card--strip[open]>summary .qa-chev { transform:rotate(90deg) }
[data-app=\"quality\"] .qa-card--strip>summary:hover .qa-chev { color:var(--cx-ink) }
[data-app=\"quality\"] .qa-card--strip .qa-name { font-weight:var(--cx-weight-strong);white-space:nowrap;min-width:0;max-inline-size:16rem;overflow:hidden;text-overflow:ellipsis;flex:0 1 auto }
[data-app=\"quality\"] .qa-card--strip .pill, [data-app=\"quality\"] .qa-card--strip .cx-chip, [data-app=\"quality\"] .qa-card--strip .qa-acts { flex:none }
[data-app=\"quality\"] .qa-card--strip .qa-meta { display:flex;align-items:center;gap:var(--cx-space-1);min-width:0;flex:1;font-size:var(--cx-text-xs);color:var(--cx-ink-3);white-space:nowrap;overflow:hidden }
[data-app=\"quality\"] .qa-card--strip .qa-meta>span { min-width:0;overflow:hidden;text-overflow:ellipsis }
[data-app=\"quality\"] .qa-card--strip .qa-meta .qa-sep { opacity:.55;flex:none }
[data-app=\"quality\"] .qa-card--strip .qa-note-txt { font-size:var(--cx-text-xs);color:var(--cx-ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;flex:1 }
[data-app=\"quality\"] .qa-card--strip .qa-meta--full { flex-wrap:wrap;white-space:normal;overflow:visible }
[data-app=\"quality\"] .qa-card--strip .qa-meta--full>span { overflow:visible;text-overflow:clip }
