[data-app=\"quality\"] section[aria-labelledby=\"qs-tbl-h\"] .qa-sub { display:inline;margin-inline-start:var(--cx-space-2) }
[data-app=\"quality\"] .qs-side { display:grid;gap:var(--cx-space-3);grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr)) }
[data-app=\"quality\"] .qs-side .cx-panel { padding:var(--cx-space-3) }
[data-app=\"quality\"] .qs-bars, [data-app=\"quality\"] .qs-others { list-style:none;margin:var(--cx-space-2) 0 0;padding:0;display:grid;gap:var(--cx-space-2) }
